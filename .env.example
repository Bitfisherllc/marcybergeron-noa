# Copy to `.env.local` for local development.

# --- PostgreSQL (required for app + seed + drizzle-kit) ---
# Option B (typical): Railway → Postgres → Connect → Public Network → copy TCP URL here and on Vercel.
# Use the public host (*.proxy.rlwy.net). Do NOT use postgres.railway.internal (only works inside Railway).
# Option A (local Docker): `docker compose up -d` then:
# DATABASE_URL=postgresql://marcy:marcy@127.0.0.1:5432/marcy
DATABASE_URL=
# Optional: if Railway gives a separate public URL variable, you can use this instead:
# DATABASE_PUBLIC_URL=

# Optional: override live site URL for admin “Live Site” buttons (e.g. https://marcybergeron-noa.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# Admin (required for /admin)
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-please-16chars-min

# Public forms send and receive as marcy@marcybergeron-noa.com (Microsoft 365).
# 1. Microsoft 365 admin → Users → the mailbox → Mail → Email apps → turn on Authenticated SMTP.
# 2. If MFA is on, create an app password for the mailbox (or use the mailbox password if MFA is off).
# 3. Set SMTP_PASS to that password here and in Vercel → Settings → Environment Variables.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=marcy@marcybergeron-noa.com
SMTP_PASS=
# Optional display name (defaults to Marcy Bergeron-Noa <marcy@marcybergeron-noa.com>):
# CONTACT_FROM_EMAIL="Marcy Bergeron-Noa <marcy@marcybergeron-noa.com>"

# Cloudflare Turnstile spam protection (contact, mailing list, workshop interest, admin login).
# Cloudflare dashboard → Turnstile → Add widget (domains: marcybergeron-noa.com, www.marcybergeron-noa.com, localhost),
# then copy the site key and secret key here and into Vercel (Production + Preview) and redeploy.
# Leave both empty to turn Turnstile off. Local testing keys that always pass:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Image uploads on Vercel (admin slideshow, series, artwork, posts)
# Vercel → Storage → Blob → create with **Public** access → connect to project.
# Private Blob stores will not work — images must be publicly viewable on the site.

# Notes
# - Apply schema: `npm run db:push` (loads `.env.local` via dotenv-cli — set DATABASE_URL there first).
# - Copy data from old SQLite `data/site.db` once: `npm run db:migrate-sqlite` (with DATABASE_URL set).
# - Fresh seed from Wix CDN: `npm run seed` (with DATABASE_URL set).
# - `data/site.db` is optional legacy storage for migration only; the running app uses Postgres only.
